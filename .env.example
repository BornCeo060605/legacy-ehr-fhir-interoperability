# LLM Provider Configuration
LLM_PROVIDER=openrouter  # Supported: openrouter, groq, openai, gemini, mock
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# API Keys & Key Rotation Pools (Never commit actual keys)
# OpenRouter (Primary)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY1=your_backup_openrouter_key_1
OPENROUTER_API_KEY2=your_backup_openrouter_key_2

# Groq Rotation Pool
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY1=your_groq_key_1
GROQ_API_KEY2=your_groq_key_2
GROQ_API_KEY3=your_groq_key_3
GROQ_API_KEY4=your_groq_key_4

# OpenAI / Generic Rotation Pool
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY1=your_openai_key_1
OPENAI_API_KEY2=your_openai_key_2
LLM_ROTATION_KEYS=key1,key2,key3,key4,key5

# Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Terminology Service Configuration (Optional)
LOINC_USERNAME=your_loinc_username_here
LOINC_PASSWORD=your_loinc_password_here
SNOMED_ENDPOINT=https://browser.ihtsdotools.org/fhir
SNOMED_API_KEY=your_snomed_api_key_here

# Retrieval & Vector Store Configuration
VECTOR_STORE_PATH=retrieval/vector_db
FHIR_RAW_PATH=resources/raw/fhir_r4
UCUM_RAW_PATH=resources/raw/ucum/ucum-essence.xml
LOINC_RAW_PATH=resources/raw/loinc
OHDSI_RAW_PATH=resources/raw/ohdsi
